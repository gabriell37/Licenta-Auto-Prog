# Configurare AutoProg — copiază acest fișier în `.env` și completează valorile.

# Baza de date. Pentru dezvoltare locală se folosește SQLite.
# Pentru producție se poate trece pe PostgreSQL (ex: postgresql://user:parola@host:5432/autoprog).
DATABASE_URL="file:./dev.db"

# Cheia secretă pentru semnarea token-urilor de autentificare (JWT).
# Pune o valoare lungă și aleatoare. Obligatorie în producție.
AUTH_SECRET="schimba-aceasta-valoare-cu-un-text-lung-si-aleatoriu"

# Setări aplicație
NEXT_PUBLIC_APP_NAME="AutoProg"
NEXT_PUBLIC_DEFAULT_LOCALE="ro"

# Opțional: 1 = afișează butoanele de logare rapidă cu conturi demo în afara modului dev.
# NEXT_PUBLIC_DEMO_ACCOUNTS="1"
